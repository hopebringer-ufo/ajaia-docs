NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Production site URL (Netlify). Used for email confirmation links.
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app

# Server-only — for Netlify build migrations (never expose as NEXT_PUBLIC_*)
# Supabase → Project Settings → Database → Connection string (URI)
# Example: postgres://postgres.[ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_DATABASE_URL=
